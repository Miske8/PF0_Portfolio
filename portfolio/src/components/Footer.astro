---
import { useTranslations, localizePath, type Lang, type RouteKey } from '../i18n/utils';
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navKeys: RouteKey[] = ['home', 'about', 'skills', 'projects', 'services', 'resume', 'contact'];
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t hairline bg-muted-surface">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <!-- Identité et disponibilité -->
    <div>
      <div class="flex items-center gap-2.5">
        <span
          class="grid size-9 place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-sm font-extrabold text-white"
          aria-hidden="true">{site.initials}</span
        >
        <span class="font-bold tracking-tight">{site.author}</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
        {site.jobTitle[lang]} — {site.location[lang]}
      </p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-700 dark:bg-ink-900 dark:text-brand-300">
        <span class="size-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
        {site.availability[lang]}
      </p>
    </div>

    <!-- Navigation -->
    <nav aria-label={t('footer.navigation')}>
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-muted">
        {t('footer.navigation')}
      </h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        {
          navKeys.map((key) => (
            <li>
              <a
                href={localizePath(key, lang)}
                class="text-muted transition hover:text-brand-700 dark:hover:text-brand-300"
              >
                {t(`nav.${key}` as never)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Contact -->
    <div>
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-muted">{t('footer.contact')}</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 text-muted transition hover:text-brand-700 dark:hover:text-brand-300"
          >
            <Icon name="mail" size={17} />
            {site.email}
          </a>
        </li>
        {
          site.socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer me"
                class="inline-flex items-center gap-2 text-muted transition hover:text-brand-700 dark:hover:text-brand-300"
              >
                <Icon name={social.icon} size={17} />
                {social.label}
                <span class="sr-only">({t('a11y.externalLink')})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t hairline">
    <div
      class="container-page flex flex-col gap-3 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.author}. {t('footer.rights')}</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span>{t('footer.builtWith')}</span>
      </p>
    </div>
  </div>
</footer>
