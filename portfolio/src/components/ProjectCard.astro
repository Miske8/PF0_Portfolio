---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/utils';
import { useTranslations, categoryLabelKey } from '../i18n/utils';
import { projectPath, slugOf, type ProjectEntry } from '../lib/projects';
import Badge from './Badge.astro';
import Icon from './Icon.astro';

interface Props {
  project: ProjectEntry;
  lang: Lang;
  /** Variante compacte utilisée dans les listes secondaires. */
  compact?: boolean;
}

const { project, lang, compact = false } = Astro.props;
const t = useTranslations(lang);
const { data } = project;
const href = projectPath(slugOf(project), lang);
---

<article
  class="group surface-card flex h-full flex-col overflow-hidden transition duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)]"
>
  <a href={href} class="flex h-full flex-col focus-visible:outline-none" tabindex="-1" aria-hidden="true">
    {
      data.cover ? (
        <div class="relative aspect-16/10 overflow-hidden bg-muted-surface">
          <Image
            src={data.cover}
            alt=""
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            class="size-full object-cover transition duration-300 group-hover:scale-[1.02]"
          />
        </div>
      ) : (
        <div class="aspect-16/10 bg-muted-surface" />
      )
    }
  </a>

  <div class={`flex flex-1 flex-col ${compact ? 'p-5' : 'p-6'}`}>
    <div class="flex flex-wrap items-center gap-2">
      <Badge variant="brand">{t(categoryLabelKey(data.category))}</Badge>
      <span class="text-xs font-medium text-muted">{data.year}</span>
      {
        data.featured && (
          <span class="ml-auto inline-flex items-center gap-1 text-xs font-semibold text-brand-700 dark:text-brand-300">
            <Icon name="sparkles" size={13} />
            {t('projects.featuredBadge')}
          </span>
        )
      }
    </div>

    <h3 class={`mt-3 font-bold leading-snug ${compact ? 'text-base' : 'text-lg'}`}>
      <a href={href} class="transition hover:text-brand-700 dark:hover:text-brand-300">
        {data.title}
      </a>
    </h3>

    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{data.summary}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t('project.stack')}>
      {
        data.stack.slice(0, compact ? 3 : 5).map((tech) => (
          <li>
            <Badge variant="outline">{tech}</Badge>
          </li>
        ))
      }
      {
        data.stack.length > (compact ? 3 : 5) && (
          <li>
            <Badge variant="outline">+{data.stack.length - (compact ? 3 : 5)}</Badge>
          </li>
        )
      }
    </ul>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 pt-1 text-sm font-semibold">
      <a
        href={href}
        class="inline-flex items-center gap-1.5 text-brand-700 transition hover:gap-2.5 dark:text-brand-300"
      >
        {t('cta.viewCase')}
        <Icon name="arrow-right" size={16} />
      </a>
      {
        data.demoUrl && (
          <a
            href={data.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-muted transition hover:text-brand-700 dark:hover:text-brand-300"
          >
            <Icon name="external-link" size={15} />
            {t('cta.liveDemo')}
            <span class="sr-only">({t('a11y.externalLink')})</span>
          </a>
        )
      }
      {
        data.repoUrl && (
          <a
            href={data.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-muted transition hover:text-brand-700 dark:hover:text-brand-300"
          >
            <Icon name="github" size={15} />
            {t('cta.sourceCode')}
            <span class="sr-only">({t('a11y.externalLink')})</span>
          </a>
        )
      }
    </div>
  </div>
</article>
