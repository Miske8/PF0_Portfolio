---
/**
 * Titre de section : surtitre, titre, description optionnelle.
 * Utilisé de façon homogène sur toutes les pages pour garantir la cohérence
 * de la hiérarchie visuelle.
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** Niveau de titre HTML (1 pour la page, 2 pour les sections). */
  level?: 1 | 2;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, level = 2, align = 'left', class: className = '' } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';

const sizeClass =
  level === 1
    ? 'text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold leading-[1.1]'
    : 'text-2xl sm:text-3xl font-bold leading-tight';
---

<div class={`${align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'} ${className}`}>
  {
    eyebrow && (
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.16em] text-brand-700 dark:text-brand-300">
        {eyebrow}
      </p>
    )
  }
  <Heading class={sizeClass}>{title}</Heading>
  {description && <p class="mt-4 text-base leading-relaxed text-muted sm:text-[1.0625rem]">{description}</p>}
</div>
