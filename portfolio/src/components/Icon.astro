---
/**
 * Jeu d'icônes SVG en ligne.
 * Toutes les icônes héritent de la couleur du texte (currentColor) et sont
 * décoratives par défaut (aria-hidden) : le sens est porté par le texte voisin.
 */
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
  /** Titre accessible, à renseigner si l'icône porte seule le sens. */
  label?: string;
}

const icons = {
  'arrow-right': { d: 'M5 12h14M13 6l6 6-6 6', fill: false },
  download: { d: 'M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M4 19h16', fill: false },
  'external-link': {
    d: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
    fill: false,
  },
  check: { d: 'M4.5 12.5 9 17l10.5-10.5', fill: false },
  menu: { d: 'M4 7h16M4 12h16M4 17h16', fill: false },
  close: { d: 'M6 6l12 12M18 6 6 18', fill: false },
  layout: { d: 'M4 5h16v14H4zM4 9h16M9 9v10', fill: false },
  server: {
    d: 'M4 5h16v5H4zM4 14h16v5H4zM8 7.5h.01M8 16.5h.01',
    fill: false,
  },
  wrench: {
    d: 'M15.5 4.5a4.5 4.5 0 0 0-5.9 5.9L4 16v4h4l5.6-5.6a4.5 4.5 0 0 0 5.9-5.9L16 11l-3-3z',
    fill: false,
  },
  users: {
    d: 'M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19M10 10.5a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5M20 19v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.5 4.2a3.25 3.25 0 0 1 0 6.1',
    fill: false,
  },
  'map-pin': { d: 'M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z', fill: false },
  clock: { d: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7.5V12l3 2', fill: false },
  calendar: { d: 'M4 6.5h16v13H4zM4 10.5h16M8.5 4v4M15.5 4v4', fill: false },
  sparkles: {
    d: 'M12 3.5 13.6 9 19 10.5 13.6 12 12 17.5 10.4 12 5 10.5 10.4 9zM18.5 15.5l.7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7z',
    fill: false,
  },
  window: { d: 'M4 5h16v14H4zM4 9h16M7 7h.01M10 7h.01', fill: false },
  code: { d: 'M9 7.5 4.5 12 9 16.5M15 7.5 19.5 12 15 16.5', fill: false },
  devices: { d: 'M3 6h13v9H3zM7.5 18.5h4M9.5 15v3.5M18 10h3v9h-3z', fill: false },
  layers: { d: 'M12 3.5 3.5 8 12 12.5 20.5 8zM3.5 12.5 12 17l8.5-4.5M3.5 16.5 12 21l8.5-4.5', fill: false },
  app: { d: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z', fill: false },
  refresh: { d: 'M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5', fill: false },
  mail: { d: 'M3.5 6h17v12h-17zM3.5 7l8.5 6 8.5-6', fill: false },
  globe: { d: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3.5 12h17M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z', fill: false },
  target: { d: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 16.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zM12 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z', fill: false },
  github: {
    d: 'M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z',
    fill: true,
  },
  linkedin: {
    d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z',
    fill: true,
  },
} as const;

const { name, size = 20, class: className = '', label } = Astro.props;
const icon = icons[name];

// Message explicite plutôt qu'une erreur obscure si un nom d'icône est erroné.
if (!icon) {
  throw new Error(
    `Icône inconnue : « ${name} ». Noms disponibles : ${Object.keys(icons).join(', ')}.`
  );
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width={icon.fill ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={icon.d}></path>
</svg>
