---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import type { Service } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  lang: Lang;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="surface-card flex h-full flex-col p-6 sm:p-7">
  <div class="flex items-center gap-3">
    <span
      class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700 dark:bg-ink-900 dark:text-brand-300"
      aria-hidden="true"
    >
      <Icon name={service.icon} size={22} />
    </span>
    <h3 class="text-lg font-bold leading-snug">{service.title[lang]}</h3>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-muted">{service.description[lang]}</p>

  <div class="mt-5">
    <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-muted">{t('services.scope')}</h4>
    <ul class="mt-3 space-y-2 text-sm">
      {
        service.scope[lang].map((item) => (
          <li class="flex gap-2.5">
            <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-600 dark:text-brand-400" />
            <span class="text-muted">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-5">
    <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-muted">
      {t('services.deliverables')}
    </h4>
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {
        service.deliverables[lang].map((item) => (
          <li class="rounded-full border border-[var(--border-subtle)] px-2.5 py-1 text-xs font-medium text-muted">
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mt-auto flex items-center gap-2 pt-6 text-sm font-semibold text-brand-700 dark:text-brand-300">
    <Icon name="sparkles" size={16} />
    <span class="sr-only">{t('services.range')} : </span>
    {service.range[lang]}
  </p>
</article>
